 	int buffer_width = output->width * output->scale,
 		buffer_height = output->height * output->scale;
+
+	if (output->config->mode == BACKGROUND_MODE_CENTER && output->config->image && output->state->subcompositor &&
+			output->state->viewporter && output->state->single_pixel_buffer_manager) {
+		if (output->committed_width != buffer_width || output->committed_height != buffer_height ||
+				output->committed_scale != output->scale) {
+			render_center(output, surface);
+		}
+		return;
+	}
 
