# agentene/browser — runtime configuration template.
#
#   cp .env.example .env    then uncomment/adjust what you need.
#
# Every variable below is optional: commented lines show the default that
# applies when it is unset or .env is missing. Values here also reach the
# container directly (env_file pass-through), so unlisted native SELKIES_*
# variables (e.g. SELKIES_FRAMERATE=30, SELKIES_TURN_URL=...) may be added.
#
# Only the knobs people commonly change are listed here. The full reference
# (build args, the native SELKIES_* media settings, ...) is the
# "Configuration" section of README.md / README.zh-CN.md.

# ---------- service toggles ----------
#ENABLE_SELKIES=true          # false = skip web UI + display + audio
#ENABLE_CDP=true              # false = skip chromium + CDP gateway
#ENABLE_HTTPS=false           # true = nginx also serves the web UI over TLS on
#                              #     container port NGINX_LISTEN_HTTPS_PORT

# ---------- extra port forwards (this container -> docker network) ----------
# Space/comma-separated LISTEN=HOST:PORT entries: nginx (already this
# container's front door) also listens on each LISTEN port and reverse-proxies
# it to HOST:PORT — typically a sibling container on the same docker network,
# addressed by container name. WebSocket-capable; the peer is resolved per
# request (this container starts even while the peer is still down). The peer
# port must be one it binds on its network address, not its own loopback
# (e.g. a sibling app container may serve its GUI on :80 network-wide while
# keeping an internal :3080 bound to its own loopback only). A LISTEN port
# must not collide with any other listen port or with the loopback internals
# (SELKIES_INTERNAL_PORT 8081, CDP_INTERNAL_PORT 9221, CDP_GATEWAY_INTERNAL_PORT
# 9220) — the entrypoint refuses to start on a clash.
#PORT_FORWARDS=3080=web:80
# Multiple entries, space or comma separated:
#PORT_FORWARDS=3080=web1:80 3081=web2:80

# ---------- HTTPS publishing (opt-in overlay) ----------
# The base compose file NEVER publishes the HTTPS port to the host. To publish
# it AND turn ENABLE_HTTPS on in one go, uncomment (docker compose reads
# COMPOSE_FILE from this .env):
#COMPOSE_FILE=compose.yaml:compose.https.yaml
# ENABLE_HTTPS=true without the overlay = HTTPS works only inside the docker
# network (e.g. behind another reverse proxy), nothing published to the host.

# ---------- host networking (opt-in overlay) ----------
# Run on the host's network stack (network_mode: host) so the browser reaches
# apps on the host directly, e.g. a dev server at http://localhost:3000.
# Keep this overlay LAST in COMPOSE_FILE:
#COMPOSE_FILE=compose.yaml:compose.host.yaml
# In this mode nginx binds its listen ports on the host itself: NGINX_LISTEN_HTTP_PORT /
# NGINX_LISTEN_HTTPS_PORT / CDP_LISTEN_PORT default to NGINX_HTTP_PORT / NGINX_HTTPS_PORT
# / CDP_PORT (8080 / 8443 / 9222), HTTPS needs only ENABLE_HTTPS=true, and the
# loopback internals (SELKIES_INTERNAL_PORT 8081, CDP_INTERNAL_PORT 9221 and
# CDP_GATEWAY_INTERNAL_PORT 9220) sit on the host's loopback — move any of them if they clash with your apps.
# NETWORK_NAME / NETWORK_EXTERNAL do not apply. The CDP endpoint has no
# authentication: on a networked machine also set NGINX_LISTEN_ADDR=127.0.0.1.

# ---------- GPU passthrough (opt-in overlay) ----------
# Pass the host GPU in so Chromium (WebGL, rasterization) and optionally the
# Selkies encoder use hardware acceleration instead of SwiftShader software
# rendering. Enable by adding the matching overlay to COMPOSE_FILE (colon-
# separated, combinable with the https overlay and with each other):
#   Intel/AMD (/dev/dri passthrough):   COMPOSE_FILE=compose.yaml:compose.gpu.yaml
#   NVIDIA (host needs nvidia-container-toolkit):
#                                       COMPOSE_FILE=compose.yaml:compose.gpu-nvidia.yaml
# CHROMIUM_GPU policy (single knob, also owns the SwiftShader fallback):
#   auto   (default) hardware GL when the container sees a GPU, else
#          SwiftShader software — WebGL always works
#   off    force software rendering even with a GPU attached
#   strict never allow SwiftShader (anti-fingerprinting): hardware GL only,
#          WebGL unavailable without a GPU
#CHROMIUM_GPU=auto

# ---------- ports: CONTAINER side (what nginx listens on) ----------
# Ports the processes bind INSIDE the container. The defaults suit plain
# port publishing; change them with network_mode: host / a shared network
# namespace, or when peers on the docker network expect specific ports.
# Published host ports below follow these automatically. With the
# compose.host.yaml overlay they default to the HOST-side values below.
#NGINX_LISTEN_HTTP_PORT=80             # web UI, HTTP
#NGINX_LISTEN_HTTPS_PORT=443           # web UI, HTTPS (ENABLE_HTTPS=true only)
#CDP_LISTEN_PORT=9222         # public CDP endpoint (nginx -> chromium, or the CDP gateway)
# Address all nginx listeners bind to; empty = all interfaces. Set 127.0.0.1
# with host networking to keep CDP + web UI off the network.
#NGINX_LISTEN_ADDR=
# Loopback-only ports behind nginx (rarely need changing; must not collide
# with the ports above):
#SELKIES_INTERNAL_PORT=8081   # selkies
#CDP_INTERNAL_PORT=9221       # chromium DevTools (--remote-debugging-port)

# ---------- ports: HOST side (docker publishing) ----------
#NGINX_HTTP_PORT=8080         # host port -> container NGINX_LISTEN_HTTP_PORT
#NGINX_HTTPS_PORT=8443        # host port -> container NGINX_LISTEN_HTTPS_PORT
#                              # (only used with the compose.https.yaml overlay)
#CDP_PORT=9222                # host port -> container CDP_LISTEN_PORT

# ---------- TLS (HTTPS) ----------
# Certificate reuse: any EXISTING VALID pair is reused as-is (self-signed
# counts as valid; "valid" = parseable cert + key that belong together). A
# self-signed pair is generated only when no usable pair is found — into
# the certificate directory when writable (the ./tls bind mount, so it
# persists and is reused on later starts), otherwise into the container.
# Drop fullchain.pem + privkey.pem into ./tls to use your own certificate
# (compose.https.yaml mounts ${TLS_CERTS_HOST_DIR:-./tls} -> /etc/nginx/tls;
# without that overlay nothing is mounted and no ./tls is created).

# ---------- selkies ----------
# Set a password to enable the login screen (username defaults to "ubuntu",
# override with SELKIES_BASIC_AUTH_USER). Empty = no login.
#SELKIES_BASIC_AUTH_PASSWORD=
# URL path prefix the web UI is served under, e.g. /desk ->
# http://host:port/desk/ (slashes optional; empty = site root). When an outer
# reverse proxy mounts it under a domain subpath, forward the path UNCHANGED
# (nginx: `location /desk/ { proxy_pass http://this-host:8080; }` — no URI
# part on proxy_pass) and pass the WebSocket Upgrade/Connection headers.
#SELKIES_SUBFOLDER=
# Extra CLI flags passed to `selkies`
#SELKIES_EXTRA_ARGS=
# Browser-driven resize: the virtual display follows the viewer's browser
# window size.
# false = the display stays at SCREEN_GEOMETRY whoever watches
#SELKIES_ENABLE_RESIZE=true
# Media (audio, microphone, webcam, gamepad) all start off and are toggled
# from the side menu. SELKIES_<MEDIA>_ENABLED=false removes one entirely,
# SELKIES_<MEDIA>_ON_START=true starts it with the session, and "|locked"
# (e.g. false|locked) stops viewers from changing a value — see the README.
#SELKIES_AUDIO_ON_START=false

# ---------- chromium ----------
# 0 = headed on the desktop (visible in the Selkies stream); 1 = headless
#CHROMIUM_HEADLESS=0
# Browser UI locale + Accept-Language (default English; e.g. zh-CN)
#CHROMIUM_LANG=en-US
# Page opened at startup
#CHROMIUM_START_URL=about:blank
# false = do not start the main browser with the container, so an idle
# container runs no chromium at all. The CDP gateway then starts it when the first CDP client connects, or from the CDP
# console / Selkies sidebar ("Start browser"). Closing the browser (its window,
# or "Stop" in the console) leaves the container running.
#CHROMIUM_AUTOSTART=true
# With CHROMIUM_AUTOSTART=false: close the main browser again after this many
# idle minutes — no CDP client connected, no isolated context, nobody
# watching the Selkies stream. Closed the orderly way (cookies are saved);
# the next client or "Start browser" starts it again. 0 = never.
#CHROMIUM_IDLE_TIMEOUT=0
# Extra chromium flags, e.g. --proxy-server=http://host:3128
#CHROMIUM_EXTRA_ARGS=
# The browser profile (logins, cookies, extensions) lives on the /browser
# mount, see BROWSER_DATA_HOST_DIR below.

# ---------- CDP gateway ----------
# Every ISOLATED CDP context (Playwright browser.newContext(), a
# playwright-cli session with "isolated": true) gets its own chromium on a
# clone of the main profile: it starts out logged in wherever the main
# browser is, and nothing it does reaches the main browser or other
# isolated contexts.
# Destroyed when the context closes / the client disconnects. Clients need no
# changes; default-context clients are unaffected. Dashboard (open tabs, live
# thumbnails, raise a context's window in the stream): http://host:9222/console/
# Most isolated contexts alive at once — each is a whole browser (a few
# hundred MB RAM);
# further isolated contexts fail with a "CDP context limit reached" error
#CDP_CONTEXTS_MAX=4
# The profile clones sit on the /browser mount next to the profile, so on an
# XFS/btrfs host every clone is a reflink (instant, copy-on-write).
# Gateway loopback port behind nginx (a host port with host networking)
#CDP_GATEWAY_INTERNAL_PORT=9220

# ---------- desktop ----------
# Desktop the headed browsers live on:
#   x11      (default) Xvfb (+ picom), captured by Selkies through XShm
#   wayland  labwc, a headless Wayland compositor + window manager that
#            Selkies captures on the GPU (dmabuf zero-copy). With an Intel/AMD
#            GPU (compose.gpu.yaml overlay) animated pages cost several times
#            less CPU; without a GPU it costs about the same as x11, and with
#            NVIDIA chromium loses GPU compositing there — keep x11.
#DISPLAY_BACKEND=x11
# Xvfb screen geometry WxHxD (wayland: labwc's output size); also sizes the
# Selkies stream
#SCREEN_GEOMETRY=1920x1080x24
# Container timezone (UTC = default; any IANA zone, e.g. Asia/Shanghai)
#TZ=UTC

# ---------- privilege drop ----------
# Run the desktop stack (Xvfb or labwc/picom/PulseAudio/selkies/chromium/the CDP gateway) and the
# nginx WORKERS as an unprivileged user; PID 1 and the nginx master stay
# root (binds the listen ports, reads the TLS key). Empty (default) =
# everything runs as root. Accepts an existing user name (browser ships in
# the image) or uid[:gid] — e.g. RUN_USER=1000 to match the uid that owns
# ./browser on the host; missing passwd/group entries for a
# numeric id are synthesized at startup. The browser profile directory is
# chowned to this user on every start (a no-op walk once it is owned, but
# the first migration of a large root-owned profile can take a moment).
#RUN_USER=

# ---------- container ----------
# Host-side directories for the browser data (mounted at /browser: profile in
# user-data/, CDP context clones in contexts/) and TLS certificates
# (the latter mounted only by compose.https.yaml)
#BROWSER_DATA_HOST_DIR=./browser
#TLS_CERTS_HOST_DIR=./tls

# ---------- docker network ----------
# Network the container attaches to. Unset = compose's own
# "<project>_default" network (today's behavior).
#NETWORK_NAME=
# false (default) = compose creates and manages the network (`down` removes
# it); true = the network already exists (e.g. shared with another stack) and
# compose only attaches to it, never creates/removes it.
#NETWORK_EXTERNAL=false
