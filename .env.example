# agentene/browser — deployment configuration template.
# Browser, capacity, desktop and AI input preferences are configured in the web
# console / sidebar Settings page, saved under ./browser/settings/settings.json.
# Save and apply updates live preferences; the page identifies pending restarts.
# Removed preference environment variables are ignored (see README migration).
#
#   cp .env.example .env    then uncomment/adjust what you need.
#
# Every variable below is optional. Compose also passes unlisted native
# SELKIES_* settings such as SELKIES_FRAMERATE or SELKIES_TURN_URL to the
# container through env_file.
#
# Only the knobs people commonly change are listed here. The full reference
# (build args, the native SELKIES_* media settings, ...) is the
# "Configuration" section of README.md / README.zh-CN.md.

# ---------- service toggles ----------
#ENABLE_SELKIES=true          # false = skip desktop streaming + audio; keep web console and virtual desktop
#ENABLE_CDP=true              # false = skip Chromium + public CDP; keep web Settings
#ENABLE_AUTH=true             # built-in login: the first visit of the web UI or
#                              #     the CDP console sets up the admin login (or
#                              #     skips it) with the setup code from the
#                              #     container log; login + CDP API key are
#                              #     changed in the console settings, kept in
#                              #     ./browser/settings/auth.json. false = no
#                              #     login, no API key (everything open)
#ENABLE_HTTPS=false           # true = also serve the web UI over TLS;
#                              #     see HTTPS publishing below

# ---------- extra port forwards (this container -> docker network) ----------
# Space/comma-separated LISTEN=HOST:PORT entries: nginx (already this
# container's front door) also listens on each LISTEN port and reverse-proxies
# it to HOST:PORT — typically a sibling container on the same docker network,
# addressed by container name. WebSocket-capable; the peer is resolved per
# request (this container starts even while the peer is still down). The peer
# port must be one it binds on its network address, not its own loopback
# (e.g. a sibling app container may serve its GUI on :80 network-wide while
# keeping an internal :3080 bound to its own loopback only). A LISTEN port
# must not collide with any other listen port — the entrypoint refuses to
# start on a clash.
#PORT_FORWARDS=3080=web:80
# Multiple entries, space or comma separated:
#PORT_FORWARDS=3080=web1:80 3081=web2:80

# ---------- HTTPS publishing (opt-in overlay) ----------
# The base compose file NEVER publishes the HTTPS port to the host. To publish
# it AND turn ENABLE_HTTPS on in one go, uncomment (docker compose reads
# COMPOSE_FILE from this .env):
#COMPOSE_FILE=compose.yaml:compose.https.yaml
# In bridge mode, ENABLE_HTTPS=true without the overlay = HTTPS works only
# inside the docker network, nothing published to the host.

# ---------- host networking (opt-in overlay) ----------
# Run on the host's network stack (network_mode: host) so the browser reaches
# apps on the host directly, e.g. a dev server at http://localhost:3000.
# Keep this overlay LAST in COMPOSE_FILE:
#COMPOSE_FILE=compose.yaml:compose.host.yaml
# The same three port settings below now select the ports nginx binds on the
# host itself; access URLs stay the same. HTTPS needs only ENABLE_HTTPS=true.
# To persist certificates in ./tls, add compose.https.yaml before this overlay.
# Only nginx takes host ports: the services behind it are on unix sockets and
# the browsers have no DevTools port.
# NETWORK_NAME / NETWORK_EXTERNAL do not apply. Until a CDP API key is set,
# the CDP endpoint is open. LISTEN_ADDR defaults to 127.0.0.1 (host-local).

# ---------- GPU passthrough (opt-in overlay) ----------
# Pass the host GPU in so Chromium (WebGL, rasterization) and optionally the
# Selkies encoder use hardware acceleration instead of SwiftShader software
# rendering. Enable by adding the matching overlay to COMPOSE_FILE (colon-
# separated, combinable with the https overlay and with each other):
#   Intel/AMD (/dev/dri passthrough):   COMPOSE_FILE=compose.yaml:compose.gpu.yaml
#   NVIDIA (host needs nvidia-container-toolkit):
#                                       COMPOSE_FILE=compose.yaml:compose.gpu-nvidia.yaml
# Rendering automatically uses available hardware with software fallback.

# ---------- ports (bridge and host networking) ----------
# Configure these three access ports in either Compose network mode:
#   bridge (default): Docker publishes them to container ports 80 / 443 / 9222.
#   host overlay:    the services listen on these ports directly on the host.
#HTTP_PORT=8080              # web UI, HTTP
#HTTPS_PORT=8443             # web UI, HTTPS: bridge needs compose.https.yaml;
#                              #     host needs ENABLE_HTTPS=true
#CDP_PORT=9222               # public CDP endpoint

# ---------- listener address and accepted hosts ----------
# Access address; unset or empty = 127.0.0.1 (host-local).
# Bridge: Docker publishes on this host address; the container listens on
# 0.0.0.0 to receive forwarded traffic. Host: listeners bind this address directly.
# Set 0.0.0.0 for all IPv4 interfaces, or a specific IP (bare IPv6, e.g. ::1).
#LISTEN_ADDR=127.0.0.1
# Host names the web UI + CDP port answer to (comma-separated, .example.com =
# subdomains too; IP addresses and localhost always work); others get 421.
# Set it when the web UI is open (login skipped / ENABLE_AUTH=false): it stops
# DNS rebinding. Empty = any host name.
#ALLOWED_HOSTS=browser.example.com

# ---------- TLS (HTTPS) ----------
# Certificate reuse: any EXISTING VALID pair is reused as-is (self-signed
# counts as valid; "valid" = parseable cert + key that belong together). A
# self-signed pair is generated only when no usable pair is found — into
# the certificate directory when writable (the ./tls bind mount, so it
# persists and is reused on later starts), otherwise into the container.
# Drop fullchain.pem + privkey.pem into ./tls to use your own certificate
# (compose.https.yaml mounts ${TLS_CERTS_HOST_DIR:-./tls} -> /etc/nginx/tls;
# without that overlay nothing is mounted and no ./tls is created).

# ---------- web paths and selkies ----------
# Authentication is managed by ENABLE_AUTH and the console.
# URL path prefix the desktop is served under (default /browser), e.g. /desk ->
# http://host:port/desk/ (slashes optional; empty = site root). When an outer
# reverse proxy mounts it under a domain subpath, forward the path UNCHANGED
# (nginx: `location /desk/ { proxy_pass http://this-host:8080; }` — no URI
# part on proxy_pass) and pass the WebSocket Upgrade/Connection headers.
# Also forward the console prefix, including its __auth/ login routes.
#BROWSER_SUBPATH=/browser
# Console prefix (default /console); slashes optional; explicit empty = root.
# With streaming enabled, the two paths must differ. Nesting is supported
# when it does not shadow the containing application's API/resources.
#CONSOLE_SUBPATH=/console
# Extra CLI flags passed to `selkies`
#SELKIES_EXTRA_ARGS=
# Initial resolution, browser language, isolated-browser capacity and AI input
# display are managed in web Settings. Audio starts on; viewers can toggle it.
# Other native SELKIES_* media settings still pass through via env_file.

# ---------- chromium advanced deployment ----------
# Extra chromium flags, e.g. --proxy-server=http://host:3128
#CHROMIUM_EXTRA_ARGS=
# The browser profile (logins, cookies, extensions) lives on the /browser mount.

# ---------- desktop ----------
# Desktop the headed browsers live on:
#   wayland  (default) labwc, a headless Wayland compositor + window manager
#            that Selkies captures on the GPU (dmabuf zero-copy). With an
#            Intel/AMD GPU (compose.gpu.yaml overlay) animated pages cost
#            several times less CPU; without a GPU it costs about the same as
#            x11.
#   x11      Xvfb (+ picom), captured by Selkies through XShm. Use it with an
#            NVIDIA GPU: chromium gets no GPU compositing on Wayland there.
#DISPLAY_BACKEND=wayland
# Container timezone (UTC = default; any IANA zone, e.g. Asia/Shanghai)
#TZ=UTC

# ---------- privilege drop ----------
# The user the desktop stack (Xvfb or labwc/picom/PulseAudio/selkies/chromium/
# the CDP gateway/the auth service) and the nginx WORKERS run as; PID 1 and
# the nginx master stay root (binds the listen ports, reads the TLS key).
# Unset or empty (default) = browser, the unprivileged user the image ships
# (uid 1001). Accepts an existing user name or uid[:gid] — e.g.
# RUN_USER=1000 to match the uid that owns ./browser on the host; missing
# passwd/group entries for a numeric id are synthesized at startup.
# RUN_USER=0 = everything runs as root (no privilege drop). The browser
# profile directory is chowned to the user on every start (a no-op walk once
# it is owned, but the first migration of a large root-owned profile can
# take a moment).
#RUN_USER=browser
# Chromium's own sandbox (renderers in user/PID/network namespaces) needs
# a non-root RUN_USER (the default) plus a container that may create user namespaces — docker's
# default seccomp profile forbids that; e.g. in a compose override:
#   security_opt: ["seccomp=unconfined"]   (or a profile allowing them)
# auto (default) = sandboxed when both hold, --no-sandbox otherwise
#CHROMIUM_SANDBOX=auto

# ---------- container ----------
# Host-side directories for the browser data (mounted at /browser: profile in
# user-data/, CDP context clones in contexts/) and TLS certificates
# (the latter mounted only by compose.https.yaml)
#BROWSER_DATA_HOST_DIR=./browser
#TLS_CERTS_HOST_DIR=./tls

# ---------- docker network ----------
# Network the container attaches to. Unset = compose's own
# "<project>_default" network (today's behavior).
#NETWORK_NAME=
# false (default) = compose creates and manages the network (`down` removes
# it); true = the network already exists (e.g. shared with another stack) and
# compose only attaches to it, never creates/removes it.
#NETWORK_EXTERNAL=false
