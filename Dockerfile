## agentene/browser

# Selkies upstream release: the wheels installed in the image (Step 2) and the
# device interposers built below come from the same tag.
ARG SELKIES_VERSION=2.2.1

# === BUILD the Selkies device interposers ===
# LD_PRELOAD libraries that hand the viewer's webcam and gamepads to Chromium
# in an unprivileged container, with no /dev/video* or /dev/uinput:
# selkies_v4l2_interposer.so (a /dev/video0 fed over Selkies' webcam socket),
# selkies_input_interposer.so (/dev/input/js*/event1000+ over its gamepad
# sockets) and fake-udev's libudev.so.1 (lists those pads to Chromium, which
# discovers gamepads through libudev; everything else passes through to the
# real libudev). The release wheel carries none of them, so they are built
# from the tag's source; the entrypoint preloads them into Chromium only
# (entrypoint/lib/chromium.sh) — never into Selkies, which needs the real
# device nodes.
FROM ubuntu:26.04 AS interposers
ARG DEBIAN_FRONTEND=noninteractive
ARG SELKIES_VERSION
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates gcc libc6-dev make && \
    mkdir -p /src /out && \
    curl -fsSL --retry 3 "https://github.com/selkies-project/selkies/archive/refs/tags/${SELKIES_VERSION}.tar.gz" \
    | tar -xz -C /src --strip-components=1 && \
    # no PipeWire frame source: the webcam frames come over Selkies' socket
    make -C /src/addons/v4l2-interposer && \
    make -C /src/addons/input-interposer && \
    make -C /src/addons/fake-udev && \
    cp /src/addons/v4l2-interposer/selkies_v4l2_interposer.so \
       /src/addons/input-interposer/selkies_input_interposer.so /out/ && \
    # private directory: the fake libudev.so.1 must not shadow the system one
    # for everything else in the image
    cp -L /src/addons/fake-udev/libudev.so.1 /out/libudev.so.1

FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive
# Container timezone (default UTC = system default; override at build or run
# time, e.g. --build-arg TZ=Asia/Shanghai or -e TZ=Asia/Shanghai).
ARG TZ=UTC
ARG NODE_VERSION=26 # autogenerated via ./update-chrome-node.mjs

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
# Expose the TZ build arg to runtime (Chromium/ICU and most tools read it);
# docker run -e TZ=... overrides it without a rebuild.
ENV TZ=${TZ}

# bash + pipefail so RUN pipes (chrome --version | grep, ...) fail fast
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# === INSTALL Node.js ===

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates tzdata && \
    # apt reads the ASCII-armored key as is (signed-by=*.asc), so no gpg is
    # needed to dearmor it
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL --retry 3 -o /etc/apt/keyrings/nodesource.asc https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.asc] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main" >> /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends nodejs && \
    # clean apt cache
    rm -rf /var/lib/apt/lists/* && \
    # The unprivileged user RUN_USER=browser drops to (uid 1001: ubuntu:26.04
    # already ships ubuntu as 1000). useradd, not adduser: the base image
    # only ships the former.
    groupadd -g 1001 browser && \
    useradd -m -u 1001 -g browser -G users -s /bin/bash browser

# === CHROME FOR TESTING ===
# The browser is Google's Chrome for Testing (CfT) build of the Stable
# channel, downloaded straight from the official CfT bucket. Override with any version in the CfT known-good
# feed: --build-arg CHROME_VERSION=<version>.
ARG CHROME_VERSION=157.0.8103.38
# The image is linux/amd64 only (the CfT linux64 build, x86_64 wheels).
# The apt packages: the shared libraries chrome links against, the font set
# (emoji, CJK, Thai, Cyrillic, ...) pages are expected to render with, and
# the library chrome dlopen()s at runtime (invisible to ldd):
# libgtk-3-0t64 (native file-chooser/print dialogs — without it
# <input type=file> opens nothing; chrome uses GTK 3 on X11 and Wayland
# alike, GTK 4 only with an explicit --gtk-version=4). Only fontconfig fonts
# count: chrome renders no Type1 or X11 bitmap fonts.
# unzip is needed only to unpack the archive.
RUN apt-get update && \
    apt-get install -y --no-install-recommends unzip \
    libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 \
    libcairo2 libcups2t64 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 \
    libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 \
    libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
    libfontconfig1 libfreetype6 fonts-noto-color-emoji fonts-unifont \
    fonts-liberation fonts-ipafont-gothic \
    fonts-wqy-zenhei fonts-tlwg-loma-otf fonts-freefont-ttf \
    libgtk-3-0t64 && \
    curl -fsSL --retry 3 -o /tmp/chrome.zip \
    "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/linux64/chrome-linux64.zip" && \
    unzip -q /tmp/chrome.zip -d /tmp/chrome-unpack && \
    mv /tmp/chrome-unpack/chrome-linux64 /opt/chrome-for-testing && \
    rm -rf /tmp/chrome.zip /tmp/chrome-unpack && \
    apt-get purge -y unzip && \
    rm -rf /var/lib/apt/lists/* && \
    # smoke-test: every shared library resolves and the version is the pinned one
    /opt/chrome-for-testing/chrome --version | grep -F "${CHROME_VERSION}"

# === NGINX FRONT DOOR (CDP endpoint + web reverse proxy) ===
# nginx fronts every public port (replaces the previous socat forwarder) on
# these container ports — defaults shown; NGINX_LISTEN_HTTP_PORT / NGINX_LISTEN_HTTPS_PORT /
# CDP_LISTEN_PORT change them at runtime (host-side publishing is docker's
# -p / compose ports):
#   * 0.0.0.0:80   -> Selkies web UI over HTTP (always on)
#   * 0.0.0.0:443  -> Selkies web UI over TLS (only when the container is
#     started with ENABLE_HTTPS=true; nginx does not listen on 443 otherwise.
#     The certificate pair is reused whenever a valid one exists — mounted in
#     /etc/nginx/tls, or generated on an earlier start — and a self-signed
#     pair is generated only when no usable pair is found)
#   * 0.0.0.0:9222 -> chromium loopback DevTools port. Chromium >= 111 ignores
#     --remote-debugging-address and binds DevTools to loopback only, so nginx
#     forwards the public port there. Unlike socat's raw TCP forward this is
#     an HTTP-level proxy that also speaks WebSocket (the DevTools protocol
#     runs over WebSocket), handled via the upgrade headers in the config
#     generated by entrypoint/lib/nginx.sh at every start.
RUN apt-get update && \
    apt-get install -y --no-install-recommends nginx openssl && \
    rm -rf /var/lib/apt/lists/*

# === SELKIES REMOTE DESKTOP ===
# Installed per the upstream Ubuntu instructions (selkies docs/start.md).
# Selkies serves the HTML5 web client, signaling and media on a single port
# (default 8080) over WebSockets; WebRTC is opt-in with --mode=webrtc.

# Step 1: system dependencies from the documented Ubuntu/Debian list
# (curl/ca-certificates are already installed above), minus what nothing in
# the image runs: the full Xorg server (only Xvfb is used), x11-utils, wmctrl,
# jq and python3-dev (there is no compiler to use its headers; every wheel
# is prebuilt). x11-xserver-utils stays: selkies falls back to its xrandr /
# xset binaries when a native RandR/XKB call fails.
# The lib* packages are the libraries selkies (ctypes) and pixelflux
# dlopen() at runtime, which neither apt nor ldd can see: libX11-xcb, EGL,
# GL, VA-API (libva + libva-drm: hardware H.264 on Intel/AMD; NVENC comes
# from the host-injected NVIDIA driver), Vulkan and libwayland-server. The
# others they load (libX11, libxcb, libxkbcommon, libgbm) come with the
# chrome layer above; what the wheels link against is checked by the import
# smoke test below, and pcmflux bundles its own libpulse/libXtst.
# GPU-passthrough userland (compose.gpu.yaml / compose.gpu-nvidia.yaml):
# libgl1-mesa-dri = Mesa GL/EGL drivers (iris/radeonsi/...) so chromium can
# render on a passed-through Intel/AMD GPU; mesa-vulkan-drivers = the Vulkan
# ICDs chromium's default ANGLE/Vulkan backend renders through
# (works on the Xvfb display: offscreen rendering + xcb present, no
# window-system GL visuals needed); intel-media-va-driver-non-free = Intel
# VA-API for Broadwell+ (mesa-va-drivers already covers AMD and older
# Intel); mesa-utils/vainfo/vulkan-tools = verification tools.
# NVIDIA GL/EGL/Vulkan userland is intentionally NOT installed here — the
# nvidia container toolkit injects host-matching libraries at runtime.
# picom = compositing manager for the Xvfb display: chromium only alpha-
# blends its popup (context menu) shadows when a compositor is present, so
# the entrypoint runs picom alongside Xvfb (entrypoint/lib/display-x11.sh).
# python3-xlib = the entrypoint's screen follower: no window manager runs on
# the Xvfb display, so it keeps the chromium window sized to the screen when
# Selkies resizes it (entrypoint/lib/chromium.sh).
# labwc + wlr-randr + wlrctl = the DISPLAY_BACKEND=wayland desktop (the
# default): labwc is
# the headless Wayland compositor + window manager Selkies captures (it
# maximizes the browser windows), wlr-randr sizes its output at startup and
# wlrctl raises a window for the CDP console.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3 xvfb x11-xserver-utils picom python3-xlib \
    labwc wlr-randr wlrctl pulseaudio \
    libx11-xcb1 libegl1 libgl1 libva2 libva-drm2 libvulkan1 \
    libwayland-server0 \
    mesa-va-drivers libgl1-mesa-dri intel-media-va-driver-non-free \
    mesa-vulkan-drivers mesa-utils vainfo vulkan-tools && \
    rm -rf /var/lib/apt/lists/*

# The NVIDIA Vulkan ICD manifest (nvidia_icd.json) arrives with the toolkit
# injection — CDI mounts it at /etc/vulkan/icd.d, the legacy hook at
# /usr/share/vulkan/icd.d — and the Ubuntu loader scans both paths, so
# nothing is baked here on purpose: a static copy would make the loader
# enumerate the GPU twice (verified: GPU0/GPU1 duplicates).

# Step 2: the Selkies Python package, installed from the official upstream
# release artifacts (docs.selkies.io). Selkies 2.x is a single pure-Python
# wheel that bundles the HTML5 web client; it pins matching pixelflux/pcmflux
# releases (the *_VERSION args below). All three wheels are also on PyPI, but
# the GitHub release assets are the ones fetched here and installed
# together; pip resolves
# the remaining dependencies from PyPI as prebuilt manylinux wheels, so no
# compiler is needed. Installs the one `selkies` console command; its tools
# are subcommands (`selkies resize`, `selkies gpu-probe`, `selkies session`
# — the hyphenated console scripts are gone since 2.2.0).
# ubuntu:26.04 ships Python 3.14 -> SELKIES_PYTAG=cp314; if the base image's
# Python ever moves, bump SELKIES_PYTAG (the selkies wheel itself is
# py3-none-any). python3-pip is installed and purged within this step.
# The GitHub release CDN answers these assets with intermittent 504s
# in bursts of half a minute and more, hence retries spread over ~100 s.
ARG SELKIES_VERSION
ARG PIXELFLUX_VERSION=2.2.3
ARG PCMFLUX_VERSION=2.2.1
ARG SELKIES_PYTAG=cp314
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3-pip && \
    curl -fsSL --retry 3 -o "/tmp/selkies-${SELKIES_VERSION}-py3-none-any.whl" \
    "https://github.com/selkies-project/selkies/releases/download/${SELKIES_VERSION}/selkies-${SELKIES_VERSION}-py3-none-any.whl" && \
    curl -fsSL --retry 3 -o "/tmp/pixelflux-${PIXELFLUX_VERSION}-${SELKIES_PYTAG}-${SELKIES_PYTAG}-manylinux_2_28_x86_64.whl" \
    "https://github.com/selkies-project/pixelflux/releases/download/${PIXELFLUX_VERSION}/pixelflux-${PIXELFLUX_VERSION}-${SELKIES_PYTAG}-${SELKIES_PYTAG}-manylinux_2_28_x86_64.whl" && \
    curl -fsSL --retry 3 -o "/tmp/pcmflux-${PCMFLUX_VERSION}-${SELKIES_PYTAG}-${SELKIES_PYTAG}-manylinux_2_28_x86_64.whl" \
    "https://github.com/selkies-project/pcmflux/releases/download/${PCMFLUX_VERSION}/pcmflux-${PCMFLUX_VERSION}-${SELKIES_PYTAG}-${SELKIES_PYTAG}-manylinux_2_28_x86_64.whl" && \
    PIP_BREAK_SYSTEM_PACKAGES=1 pip3 install --no-cache-dir \
    "/tmp/selkies-${SELKIES_VERSION}-py3-none-any.whl" \
    "/tmp/pixelflux-${PIXELFLUX_VERSION}-${SELKIES_PYTAG}-${SELKIES_PYTAG}-manylinux_2_28_x86_64.whl" \
    "/tmp/pcmflux-${PCMFLUX_VERSION}-${SELKIES_PYTAG}-${SELKIES_PYTAG}-manylinux_2_28_x86_64.whl" && \
    pip3 check && \
    # pip is needed only to install the wheels; none of their dependencies
    # come from the apt python3-* packages it pulls in
    apt-get purge -y --auto-remove python3-pip && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /tmp/selkies-*.whl /tmp/pixelflux-*.whl /tmp/pcmflux-*.whl && \
    # smoke-test the console commands, the exact version, the bundled web
    # client and that every library the native wheels link against resolves
    python3 -c "import pixelflux, pcmflux" && \
    selkies --help >/dev/null && \
    selkies --version | grep -qx "selkies ${SELKIES_VERSION}" && \
    selkies resize --help >/dev/null && \
    python3 -c "import importlib.resources as r; assert (r.files('selkies.selkies_web') / 'index.html').is_file(), 'web client missing'"

# The device interposers built in the first stage (see there); the entrypoint
# preloads them into Chromium from this directory.
COPY --from=interposers /out/ /usr/local/lib/selkies-interposers/

# Step 3: Selkies attaches to an existing headless labwc (or, with
# DISPLAY_BACKEND=x11, an X display) and PulseAudio server.
# docker-entrypoint.sh starts both (labwc/Xvfb + PulseAudio) plus Selkies (bound to
# loopback), Chrome for Testing and the nginx front door in one place, so
# container start is service start; combine with `docker run --restart=always`
# for boot persistence.
# The entrypoint defaults these itself (entrypoint/lib/config.sh); they are
# set here only so `docker exec` shells (glxinfo, pactl, ...) reach the
# X11 desktop (DISPLAY_BACKEND=x11). They are the defaults, not the live
# values: exec sees DISPLAY=:0 even where the entrypoint moved to a free
# display or, with the default DISPLAY_BACKEND=wayland, runs no X server at
# all (labwc's socket name is in /tmp/labwc-display).
ENV DISPLAY=":0"
ENV XDG_RUNTIME_DIR="/tmp"
ENV PULSE_RUNTIME_PATH="/tmp/pulse"
ENV PULSE_SERVER="unix:/tmp/pulse/native"

# Default ports served INSIDE the container (all by nginx; overridable at
# runtime via NGINX_LISTEN_HTTP_PORT / NGINX_LISTEN_HTTPS_PORT / CDP_LISTEN_PORT — EXPOSE is
# documentation only): 80 = web UI over HTTP (always), 443 = web UI over HTTPS
# (only when run with ENABLE_HTTPS=true — nginx does not listen on it
# otherwise), 9222 = chromium CDP endpoint. Host-side ports are chosen by
# docker run -p / compose ports.
EXPOSE 80 443 9222

# CDP gateway (always on with the CDP endpoint): a Node service between
# nginx and chromium that gives every isolated CDP context its own browser on
# a clone of the main profile. Its single dependency (ws) is pinned in
# package-lock.json and installed reproducibly with npm ci.
COPY cdp-gateway/package.json cdp-gateway/package-lock.json /usr/local/lib/cdp-gateway/
RUN npm ci --omit=dev --no-audit --no-fund --prefix /usr/local/lib/cdp-gateway && \
    rm -rf ~/.npm/
COPY cdp-gateway/gateway.mjs cdp-gateway/dashboard.html cdp-gateway/panel.js cdp-gateway/raise-window.py cdp-gateway/front-window.py /usr/local/lib/cdp-gateway/
COPY cdp-gateway/src/ /usr/local/lib/cdp-gateway/src/

# Built-in login + CDP API key (ENABLE_AUTH=true, entrypoint/lib/auth.sh): a
# dependency-free Node service nginx checks every web UI / console request
# and every CDP request with; it also serves the setup/login forms and the
# console's login + API key controls (ui.js).
COPY auth-server/server.mjs auth-server/page.html auth-server/ui.js /usr/local/lib/auth-server/
COPY auth-server/src/ /usr/local/lib/auth-server/src/

# The supervisor: a thin docker-entrypoint.sh that sources its stage modules
# (lib/*.sh) and runs the helper scripts (helpers/*) from
# /usr/local/lib/docker-entrypoint.
COPY entrypoint/ /usr/local/lib/docker-entrypoint/
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod -R u=rwX,go=rX /usr/local/lib/docker-entrypoint && \
    chmod 755 /usr/local/lib/docker-entrypoint/helpers/*.sh \
        /usr/local/bin/docker-entrypoint.sh

# Container start == services start. Any argument other than "start" is exec'd
# instead, e.g. `docker run -it <image> bash`.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

